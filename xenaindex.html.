<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>XENA</title><meta name="theme-color" content="#a855f7"><style>*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}body{background:#0b141a;color:#fff;height:100vh;display:flex;flex-direction:column}.top{height:60px;background:#202c33;display:flex;align-items:center;justify-content:space-between;padding:0 16px;font-weight:900}.logo{width:40px;height:40px;border-radius:50%;background:#a855f7;display:flex;align-items:center;justify-content:center;font-weight:900}.featBar{display:flex;gap:8px;padding:10px;background:#0b141a;border-bottom:1px solid #2a3942;overflow-x:auto}.fBtn{padding:9px 16px;border-radius:20px;background:#202c33;border:1px solid #2a3942;color:#8696a0;font-size:12px;font-weight:700}.fBtn.active{background:#a855f7;color:#fff}.main{flex:1;overflow:hidden;position:relative}.tab{display:none;height:100%;overflow-y:auto;padding-bottom:80px}.tab.active{display:block}.contactItem{padding:14px 16px;border-bottom:1px solid #1a242d;display:flex;align-items:center;gap:12px}.avatar{width:48px;height:48px;border-radius:50%;background:#a855f7;display:flex;align-items:center;justify-content:center;font-weight:800}.msg{max-width:78%;padding:10px 14px;border-radius:12px;font-size:14px;margin:6px 16px;white-space:pre-wrap}.me{background:#005c4b;align-self:flex-end;margin-left:auto}.ai{background:#202c33;align-self:flex-start;border-left:3px solid #a855f7}#bar{height:70px;background:#202c33;position:absolute;bottom:0;left:0;right:0;display:flex;align-items:center;gap:8px;padding:0 12px}#bar input{flex:1;height:44px;background:#2a3942;border:none;border-radius:22px;color:#fff;padding:0 16px;outline:none}.b{width:44px;height:44px;border-radius:50%;border:none;background:#a855f7;color:#fff}</style></head><body><div class="top"><div style="display:flex;align-items:center;gap:10px"><div class="logo">X</div><b>XENA <span style="color:#a855f7">CHAT</span></b></div><span style="background:#a855f7;padding:6px 12px;border-radius:20px;font-size:10px">ONE FILE</span></div><div class="featBar"><div class="fBtn active" onclick="openTab('chatsTab',this)">Chats</div><div class="fBtn" onclick="openTab('xenaTab',this)">XENA AI</div><div class="fBtn" onclick="openTab('galleryTab',this)">Gallery No Video</div><div class="fBtn" onclick="openTab('aboutTab',this)">About</div></div><div class="main"><div id="chatsTab" class="tab active"><div id="contactList"></div><div style="padding:16px"><button onclick="newChat()" style="width:100%;height:48px;background:#a855f7;border:none;border-radius:12px;color:#fff;font-weight:800">+ NEW XENA CHAT</button></div></div><div id="chatView" class="tab"><div style="height:56px;background:#202c33;display:flex;align-items:center;gap:12px;padding:0 16px"><span onclick="openTab('chatsTab',document.querySelectorAll('.fBtn')[0])" style="font-size:28px">Back</span><b id="chatName">XENA</b></div><div id="chatBox" style="display:flex;flex-direction:column;padding:16px"></div><div id="bar"><input id="q" placeholder="Type XENA..." onkeypress="if(event.key==='Enter')sendMsg()"><button class="b" onclick="sendMsg()">Send</button></div></div><div id="xenaTab" class="tab"><div id="xenaBox" style="display:flex;flex-direction:column;padding:16px"></div><div style="height:80px"></div><div style="height:70px;background:#202c33;position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;gap:8px;padding:0 12px"><input id="q2" placeholder="Ask XENA..." style="flex:1;height:44px;background:#2a3942;border:none;border-radius:22px;color:#fff;padding:0 16px;outline:none" onkeypress="if(event.key==='Enter')sendXena()"><button class="b" onclick="sendXena()">Send</button></div></div><div id="galleryTab" class="tab"><div style="padding:12px"><div style="background:#202c33;border-radius:16px;padding:16px"><h3>Gallery - Only XENA - No Video</h3><label style="display:block;margin-top:12px;background:#a855f7;height:46px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700">Add Photos<input type="file" id="galInput" accept="image/*" multiple style="display:none" onchange="addGallery(this)"></label><button onclick="clearG()" style="width:100%;margin-top:8px;height:40px;background:#2a3942;border-radius:10px;color:#fff;border:1px solid #333">Clear</button></div></div><div id="galleryGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px"></div></div><div id="aboutTab" class="tab"><div style="padding:16px;text-align:center"><div style="background:#202c33;border-radius:20px;padding:20px"><div class="logo" style="width:90px;height:90px;font-size:36px;margin:0 auto">X</div><h2 style="margin-top:12px">XENA CHAT - ONE FILE</h2><p style="font-size:12px;color:#a855f7;margin-top:6px">Where Every Chat Feels Like Home</p><p style="font-size:11px;color:#8696a0;margin-top:10px">ONE FILE ONLY - Drop to Netlify Drop<br>Only XENA name - No video<br>Real APK from PWABuilder<br>Made in Uganda Kampala</p><div style="margin-top:16px;background:#0b141a;padding:12px;border-radius:12px;border:1px dashed #2a3942"><p style="font-size:11px;color:#8696a0">HOW TO DOWNLOAD REAL APK:<br>1. This file -> Drop to app.netlify.com/drop<br>2. Copy Netlify URL<br>3. Paste in pwabuilder.com<br>4. Build APK - REAL!</p></div></div></div></div></div><script>let contacts=JSON.parse(localStorage.getItem('x1_c')||'[]');let chats=JSON.parse(localStorage.getItem('x1_ch')||'{}');let gallery=JSON.parse(localStorage.getItem('x1_g')||'[]');let xenaHist=JSON.parse(localStorage.getItem('x1_ai')||'[]');if(contacts.length==0){contacts=[{id:1,name:'XENA AI Real',avatar:'X'}];chats={1:[{role:'ai',text:'Welcome to ONE-FILE REAL XENA! Where Every Chat Feels Like Home. Only XENA name, No video! Drop this ONE file to Netlify Drop -> Get URL -> PWABuilder -> REAL APK!'}]};xenaHist=[{role:'ai',text:'REAL XENA AI - Only XENA! Ask: What is Kampala? What is Uganda? What is XENA?'}]}function save(){localStorage.setItem('x1_c',JSON.stringify(contacts));localStorage.setItem('x1_ch',JSON.stringify(chats));localStorage.setItem('x1_g',JSON.stringify(gallery));localStorage.setItem('x1_ai',JSON.stringify(xenaHist));render()}function openTab(id,btn){document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.fBtn').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active')}function render(){document.getElementById('contactList').innerHTML=contacts.map(c=>`<div class="contactItem" onclick="openChat(${c.id})"><div class="avatar">${c.avatar}</div><div style="flex:1"><b>${c.name}</b><div style="font-size:12px;color:#8696a0">${(chats[c.id]||[]).length} msgs - Only XENA</div></div></div>`).join('');document.getElementById('xenaBox').innerHTML=xenaHist.map(h=>`<div class="msg ${h.role=='me'?'me':'ai'}" style="margin:6px 16px">${h.text}</div>`).join('');let grid=document.getElementById('galleryGrid');grid.innerHTML=gallery.length==0?'<div style="grid-column:1/-1;text-align:center;color:#8696a0;padding:40px">No photos - Only photos No video</div>':gallery.map(g=>`<div style="aspect-ratio:1;background:#202c33;border-radius:8px;overflow:hidden"><img src="${g.img}" style="width:100%;height:100%;object-fit:cover"></div>`).join('')}function openChat(id){window.curId=id;document.getElementById('chatName').innerText=contacts.find(x=>x.id==id).name;document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));document.getElementById('chatView').classList.add('active');let box=document.getElementById('chatBox');box.innerHTML=(chats[window.curId]||[]).map(m=>`<div class="msg ${m.role=='me'?'me':'ai'}">${m.text}</div>`).join('')}function sendMsg(){let q=document.getElementById('q');let t=q.value.trim();if(!t)return;if(!chats[window.curId])chats[window.curId]=[];chats[window.curId].push({role:'me',text:t});q.value='';save();let box=document.getElementById('chatBox');box.innerHTML=chats[window.curId].map(m=>`<div class="msg ${m.role=='me'?'me':'ai'}">${m.text}</div>`).join('');setTimeout(()=>{let low=t.toLowerCase();let r=low.includes('kampala')?'Kampala capital Uganda 7 hills You are in Kampala District!':low.includes('hi')?'Hi Boss Real XENA!':'Real XENA: '+t+' - Tell more!';chats[window.curId].push({role:'ai',text:r});save();box.innerHTML=chats[window.curId].map(m=>`<div class="msg ${m.role=='me'?'me':'ai'}">${m.text}</div>`).join('')},500)}function newChat(){let n=prompt('XENA name:');if(!n)return;let id=Date.now();contacts.push({id,name:n,avatar:n[0].toUpperCase()});chats[id]=[];save()}function addGallery(inp){for(let f of inp.files){let r=new FileReader();r.onload=e=>{gallery.push({img:e.target.result});save()};r.readAsDataURL(f)}}function clearG(){if(confirm('Clear?')){gallery=[];save()}}function sendXena(){let q=document.getElementById('q2');let t=q.value.trim();if(!t)return;xenaHist.push({role:'me',text:t});q.value='';save();setTimeout(()=>{let r=t.toLowerCase().includes('kampala')?'Kampala capital Uganda!':`Real XENA: ${t} - I understand!`;xenaHist.push({role:'ai',text:r});save()},600)}render();</script></body></html>