import express from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import OpenAI from 'openai';

dotenv.config();

const app = express();
const PORT = Number(process.env.PORT || 4000);

app.use(cors());
app.use(express.json({ limit: '1mb' }));

const profileBias = {
  balanced: 0.7,
  ambitious: 0.9,
  cautious: 0.45
};

function buildFallbackCards(prompt, mode, profile) {
  const cleanPrompt = prompt.trim() || 'a new opportunity';
  const words = cleanPrompt.split(/\s+/).filter(Boolean);
  const lead = words.slice(0, 3).join(' ') || 'the challenge';
  const profileLabel = profile || 'balanced';

  const base = [
    {
      label: 'Core direction',
      title: 'Opportunity framing',
      content: `Use ${cleanPrompt} to define a compelling problem statement, customer value, and a clear reason the idea matters in context.`
    },
    {
      label: 'Creative lens',
      title: 'Best next angle',
      content: `Explore the most promising angle around ${lead} and test it with the smallest possible audience to learn quickly.`
    },
    {
      label: 'Risk review',
      title: 'Where this could fail',
      content: `Review dependencies, adoption friction, decision bottlenecks, and implementation risk before locking in the plan.`
    },
    {
      label: 'Action plan',
      title: 'Immediate next step',
      content: `Define a 7-day action, assign ownership, and decide what evidence will prove the direction is worth continuing.`
    }
  ];

  if (mode === 'decision') {
    return [
      {
        label: 'Criteria',
        title: 'Decision filters',
        content: `Score ${cleanPrompt} against urgency, cost, risk, strategic fit, and customer impact with the ${profileLabel} profile in mind.`
      },
      {
        label: 'Trade-off',
        title: 'Big trade-off',
        content: `Identify the single most important trade-off and decide whether the opportunity is worth the cost of complexity or slower execution.`
      },
      {
        label: 'Upside',
        title: 'Best path',
        content: `The best path is the one that balances near-term momentum with resilience if user needs or market conditions shift.`
      },
      {
        label: 'Recommendation',
        title: 'Decision call',
        content: `Move forward with the highest-signal option and validate it with a small experiment before scaling resources.`
      }
    ];
  }

  if (mode === 'plan') {
    return [
      {
        label: 'Goal',
        title: 'Target outcome',
        content: `Define the concrete result you want from ${cleanPrompt}, including what success looks like and what will signal that the work is done.`
      },
      {
        label: 'Milestone',
        title: 'Execution stages',
        content: `Create 3–5 milestones tied to measurable outputs, decision gates, and owner accountability to prevent drift.`
      },
      {
        label: 'Support',
        title: 'Required inputs',
        content: `List the people, tools, and approvals required to move from concept into delivery without unnecessary bottlenecks.`
      },
      {
        label: 'Review cadence',
        title: 'Governance rhythm',
        content: `Schedule weekly progress reviews, surface open risks early, and adjust priorities based on evidence instead of assumptions.`
      }
    ];
  }

  if (mode === 'analysis') {
    return [
      {
        label: 'Signal',
        title: 'Observed pattern',
        content: `Examine the strongest evidence behind ${cleanPrompt} to determine whether the pattern is a real opportunity or a temporary distraction.`
      },
      {
        label: 'Evidence',
        title: 'Proof points',
        content: `Separate direct evidence from assumptions, and test whether the idea is supported by repeatable behaviors or just a single observation.`
      },
      {
        label: 'Interpretation',
        title: 'Meaning',
        content: `The likely interpretation is that the idea has traction only if it solves a recurring pain with clear urgency and reasonable complexity.`
      },
      {
        label: 'Conclusion',
        title: 'Decision read',
        content: `Treat this as a hypothesis: continue when the evidence remains strong, pause when the signals weaken or become inconsistent.`
      }
    ];
  }

  return base;
}

app.get('/api/health', (_req, res) => {
  res.json({ status: 'ok' });
});

app.post('/api/generate', async (req, res) => {
  const { prompt, mode = 'brainstorm', profile = 'balanced' } = req.body || {};
  const cleanPrompt = String(prompt || '').trim();

  if (!cleanPrompt) {
    return res.status(400).json({ error: 'Prompt is required to generate a thought map.' });
  }

  const finalMode = ['brainstorm', 'decision', 'plan', 'analysis'].includes(mode) ? mode : 'brainstorm';
  const finalProfile = ['balanced', 'ambitious', 'cautious'].includes(profile) ? profile : 'balanced';

  try {
    if (!process.env.OPENAI_API_KEY) {
      const fallback = buildFallbackCards(cleanPrompt, finalMode, finalProfile);
      return res.json({
        title: cleanPrompt.slice(0, 48).trim() || 'Untitled thought',
        summary: `A ${finalProfile} ${finalMode} session focused on ${cleanPrompt}.`,
        cards: fallback
      });
    }

    const client = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
    const completion = await client.chat.completions.create({
      model: 'gpt-4o-mini',
      temperature: profileBias[finalProfile] ?? 0.7,
      response_format: { type: 'json_object' },
      messages: [
        {
          role: 'system',
          content: `You are a strategic reasoning assistant. Generate a concise, valuable thinking map for a user. Return valid JSON with keys: title, summary, cards. cards must be an array of objects with label, title, content. Keep the tone sharp, clear, and actionable. The mode is ${finalMode}. The profile is ${finalProfile}.`
        },
        {
          role: 'user',
          content: cleanPrompt
        }
      ]
    });

    const content = completion.choices?.[0]?.message?.content;
    if (!content) {
      throw new Error('No content returned from model.');
    }

    const payload = JSON.parse(content);
    const cards = Array.isArray(payload.cards) && payload.cards.length > 0 ? payload.cards : buildFallbackCards(cleanPrompt, finalMode, finalProfile);

    return res.json({
      title: payload.title || cleanPrompt.slice(0, 48).trim() || 'Untitled thought',
      summary: payload.summary || `A ${finalProfile} ${finalMode} session focused on ${cleanPrompt}.`,
      cards
    });
  } catch (error) {
    const fallback = buildFallbackCards(cleanPrompt, finalMode, finalProfile);
    return res.json({
      title: cleanPrompt.slice(0, 48).trim() || 'Untitled thought',
      summary: `A ${finalProfile} ${finalMode} session focused on ${cleanPrompt}.`,
      cards: fallback,
      warning: error instanceof Error ? error.message : 'AI generation failed; fallback used.'
    });
  }
});

app.listen(PORT, () => {
  console.log(`MindForge API running on http://localhost:${PORT}`);
});
